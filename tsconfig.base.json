{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": false,
    "noEmitOnError": true,
    "incremental": true,
    "composite": true,
    "baseUrl": ".",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    
    "paths": {
      "@mentor-ai/types": ["./packages/types/src"],
      "@mentor-ai/utils": ["./packages/utils/src"],
      "@mentor-ai/database": ["./packages/database/src"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "**/*.js",
    "**/*.d.ts"
  ]
}